{
  "name": "sumi",
  "version": "1.9.0",
  "description": "A task-focused intelligent workspace for collaborative research, editable documents, skill-driven deliverables, and personal knowledge.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "postinstall": "electron-builder install-app-deps",
    "pack": "electron-builder --dir && npm run verify:packaged",
    "dist": "electron-builder && npm run verify:packaged",
    "release": "npm run verify && electron-builder --publish never && npm run verify:packaged && node scripts/publish-verified-artifacts.mjs",
    "verify:packaged": "npm run verify:packaged-skills && npm run verify:packaged-app",
    "verify:packaged-skills": "node scripts/verify-packaged-skills.mjs",
    "verify:packaged-app": "node scripts/verify-packaged-app.mjs"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "^0.3.241",
    "@sentry/electron": "^7.17.0",
    "chokidar": "^5.0.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "js-yaml": "^5.3.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/asar": "^3.4.1",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tiptap/core": "^3.30.2",
    "@tiptap/extension-code-block-lowlight": "^3.30.2",
    "@tiptap/extension-highlight": "^3.30.2",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-table-cell": "^3.30.2",
    "@tiptap/extension-table-header": "^3.30.2",
    "@tiptap/extension-table-row": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/extension-typography": "^3.30.2",
    "@tiptap/markdown": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/suggestion": "^3.30.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-flip-toolkit": "^7.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-zoom-pan-pinch": "^4.0.4",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.23.0",
    "streamdown": "^2.5.0",
    "tippy.js": "^6.3.7",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  }
}
